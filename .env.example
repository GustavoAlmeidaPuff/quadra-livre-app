# Firebase (mesmo projeto do app web)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Google OAuth (login nativo via @react-native-google-signin/google-signin)
# Web Client ID - o mesmo usado pelo Firebase/app web. É o que emite o idToken
# validado pelo Firebase, em todas as plataformas (Android/iOS/web).
# Criar em: Firebase Console → Authentication → Sign-in method → Google → Web SDK configuration
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS Client ID - Google Cloud Console → Credentials → criar "iOS" OAuth client
# com o bundle id do app (com.quadralivreigrejinha.app). Necessário só pra testar em iOS.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Android NÃO usa client id aqui: crie um OAuth client "Android" no Google Cloud
# Console vinculado ao package (com.quadralivreigrejinha.app) + SHA-1 do build/keystore.
# O Google casa automaticamente pelo package+SHA-1, sem precisar de env var.

# Backend local (quando existir API própria; Postgres via docker-compose)
# DATABASE_URL=postgresql://quadra:quadra@localhost:5432/quadra_livre
